# Copy to .env on the server:  cp .env.example .env
# Host port for the web UI (ports already used on the server: 3000 3100 3200 5432 8000 8080 8090 11435)
OMR_HOST_PORT=8510
# 0.0.0.0 = reachable from outside; 127.0.0.1 = only via a reverse proxy on the same server
OMR_BIND=0.0.0.0
OMR_CPUS=2
OMR_MEMORY=2g
OMR_MAX_UPLOAD_MB=500
OMR_LOG_LEVEL=INFO
